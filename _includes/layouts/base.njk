<!doctype html>
<html lang="zh-Hant-TW">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = (title + "｜" + site.title) if title else site.title %}
  {%- set pageDesc = site.description if locked else (description or site.description) %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:type" content="{{ 'article' if layout == 'layouts/post.njk' else 'website' }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="zh_TW">
  <meta name="theme-color" content="#F1F5EC" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#13211A" media="(prefers-color-scheme: dark)">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=LXGW+WenKai+TC:wght@400;700&family=Noto+Sans+TC:wght@400;500;700&display=swap">
  <link rel="stylesheet" href="/assets/css/main.css">
  {%- if content | hasMath %}
  <link rel="stylesheet" href="/assets/katex/katex.min.css">
  {%- endif %}
  <script>
    (function () {
      try { var t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    })();
  </script>
</head>
<body>
  <a class="skip-link" href="#main">跳到內容</a>
  {%- set u = page.url %}
  <header class="bb-header">
    <div class="bb-band">
      <a class="bb-title" href="/">{{ site.title }}</a>
      <p class="bb-sub">{{ site.subtitle }}</p>
      <button class="theme-toggle" type="button" aria-label="切換深色或淺色模式" data-theme-toggle>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path class="icon-moon" d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/><g class="icon-sun"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></g></svg>
      </button>
    </div>
    <nav class="bb-nav" aria-label="主選單">
      <ul class="bb-menu">
        <li><a href="/" {% if u == "/" %}aria-current="page"{% endif %}>最新文章</a></li>
        <li><a href="/plan/" {% if u.startsWith("/plan/") %}aria-current="page"{% endif %}>學習計畫</a></li>
        <li>
          <details class="nav-group" data-nav-group>
            <summary {% if u.startsWith("/learn/") %}class="is-current"{% endif %}>學習科目</summary>
            <div class="nav-panel">
              <ul class="nav-cols">
                {%- for s in plan.subjects %}
                <li><a href="/learn/{{ s.slug }}/" {% if u == "/learn/" + s.slug + "/" %}aria-current="page"{% endif %}>{{ s.short }}</a></li>
                {%- endfor %}
                <li class="nav-all"><a href="/learn/">所有科目</a></li>
              </ul>
            </div>
          </details>
        </li>
        <li><a href="/exams/" {% if u == "/exams/" %}aria-current="page"{% endif %}>考試時程</a></li>
        <li>
          <details class="nav-group" data-nav-group>
            <summary {% if u.startsWith("/life/") %}class="is-current"{% endif %}>生活</summary>
            <div class="nav-panel">
              <ul>
                {%- for c in life %}
                <li><a href="/life/{{ c.slug }}/" {% if u == "/life/" + c.slug + "/" %}aria-current="page"{% endif %}>{{ c.name }}</a></li>
                {%- endfor %}
                <li class="nav-all"><a href="/life/">生活總覽</a></li>
              </ul>
            </div>
          </details>
        </li>
        <li><a href="/about/" {% if u == "/about/" %}aria-current="page"{% endif %}>關於菜菜</a></li>
      </ul>
    </nav>
  </header>

  {% include "sprouts.njk" %}

  <div class="bb-wrap">
    <main id="main" class="bb-main">
      {%- if locked %}
      <!--LOCK-START-->{{ content | safe }}<!--LOCK-END-->
      {%- else %}
      {{ content | safe }}
      {%- endif %}
    </main>
    {% include "sidebar.njk" %}
  </div>

  <footer class="site-footer">
    <div class="bb-footer">
      <p>© {{ buildYear }} {{ site.title }}</p>
      <p class="footer-links"><a href="/plan/">學習計畫</a><a href="/tags/">標籤</a><a href="/feed.xml">RSS 訂閱</a></p>
    </div>
  </footer>
  <script src="/assets/js/theme.js" defer></script>
  <script src="/assets/js/lock.js" defer></script>
</body>
</html>
